# ==============================================================================
# StreamShield Frontend Environment Configuration (.env.example)
# ==============================================================================

# Backend API Base URL
# - Local Development: http://localhost:8000
# - Cloud Production: https://your-backend-api.onrender.com
# (Note: /api/v1 is appended automatically if omitted)
VITE_API_BASE_URL=http://localhost:8000

# Optional: Dedicated root backend URL for health probes (defaults to VITE_API_BASE_URL host)
VITE_BACKEND_URL=http://localhost:8000

# Application Branding Title
VITE_APP_NAME="StreamShield Intelligence"


