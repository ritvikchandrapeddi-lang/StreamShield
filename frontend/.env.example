# ==============================================================================
# StreamShield Frontend Environment Configuration (.env.example)
# ==============================================================================

# Backend API Base URL
# - Deployed Production Backend: https://streamshield-309p.onrender.com
# - Local Development Backend: http://localhost:8000
# (Note: /api/v1 is appended automatically if omitted)
VITE_API_BASE_URL=https://streamshield-309p.onrender.com

# Dedicated root backend URL for health probes (defaults to VITE_API_BASE_URL host)
VITE_BACKEND_URL=https://streamshield-309p.onrender.com

# Application Branding Title
VITE_APP_NAME="StreamShield Intelligence"
