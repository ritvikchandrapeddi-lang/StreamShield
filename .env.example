# ==============================================================================
# StreamShield - Environment Variables Template (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - Copy this file to '.env' for local configuration.
# - DO NOT commit real secrets, API keys, or production credentials to Git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_this_to_a_secure_random_secret_in_local_env
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration (Vite + React)
VITE_API_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL / Timescale / Graph)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/streamshield_db

# Message Streaming / Message Broker (e.g., Apache Kafka / Redpanda)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=streamshield.transactions.incoming
KAFKA_TOPIC_ALERTS=streamshield.fraud.alerts

# In-Memory Cache & State Store (Redis)
REDIS_URL=redis://localhost:6379/0

# Optional AI / LLM Intelligence Services (Placeholders Only)
AI_ENGINE_API_KEY=your_placeholder_ai_key_here

