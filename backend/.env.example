# ==============================================================================
# StreamShield Backend Environment Configuration (.env.example)
#
# IMPORTANT:
# - Copy this file to '.env' for local development.
# - Do NOT commit real secrets or production passwords to Git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="StreamShield Fraud Intelligence API"
VERSION="0.2.0"
SECRET_KEY="streamshield-insecure-dev-secret-key-change-in-prod"

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Default: Local SQLite database (zero external infrastructure needed)
DATABASE_URL="sqlite:///./streamshield.db"

# PostgreSQL Configuration Example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streamshield"
DATABASE_ECHO=False
AUTO_SEED=True

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://streamshield.vercel.app"
